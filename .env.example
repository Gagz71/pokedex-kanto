# Supabase (synchronisation de la progression entre appareils).
# Copier ce fichier en .env et y mettre les valeurs du projet Supabase — les
# mêmes que dans ~/Bureau/pokedex-hisui/.env pour partager le même compte.
# Valeurs PUBLIQUES par conception : elles finissent dans le code envoyé au
# navigateur. La protection des données repose sur les règles RLS de la table
# (voir supabase/schema.sql). Ne JAMAIS mettre ici la clé « secret » ou
# « service_role ».
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
